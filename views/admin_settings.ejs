<%- include('partials/header', { title: 'Settings' }) %>

<!-- Library jsQR untuk decode QR dari gambar (client-side) -->
<script src="https://unpkg.com/jsqr@1.4.0/dist/jsQR.js"></script>

<style>
  .custom-scroll::-webkit-scrollbar { width: 2px; height: 2px; }
  .custom-scroll::-webkit-scrollbar-track { background: transparent; margin-top: 10px; margin-bottom: 10px; }
  .custom-scroll::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
  .custom-scroll:hover::-webkit-scrollbar-thumb { background-color: #94a3b8; }
</style>

<div class="px-6 pb-6 mt-1 max-w-[480px] md:max-w-lg mx-auto">

  <!-- Notifikasi lokal (dinamis via JS) -->
  <div id="localNotif" class="hidden bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
    <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
    <p id="localNotifMessage"></p>
    <button type="button" onclick="this.parentElement.classList.add('hidden')" class="ml-auto text-gray-400 hover:text-gray-600">&times;</button>
  </div>

  <!-- Alert Success dari server -->
  <% if (typeof success !== 'undefined' && success) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-green-100 flex items-center justify-center shrink-0"><i class="fas fa-check-circle text-xs"></i></div>
      <p><%= success %></p>
    </div>
  <% } %>
  
  <!-- Alert Error dari server -->
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-4 text-xs font-medium flex items-center gap-3">
      <div class="w-7 h-7 rounded-xl bg-red-100 flex items-center justify-center shrink-0"><i class="fas fa-exclamation-circle text-xs"></i></div>
      <p><%= error %></p>
    </div>
  <% } %>

  <form method="POST" action="/admin/settings" enctype="multipart/form-data" id="mainSettingsForm">
    <!-- JSON withdrawMethods akan diisi oleh JavaScript -->
    <input type="hidden" name="withdrawMethodsJson" id="withdrawMethodsJsonInput" value="<%= JSON.stringify(settings.withdrawMethods || []) %>">
    <!-- JSON instantWithdrawMethods -->
    <input type="hidden" name="instantWithdrawMethodsJson" id="instantWithdrawMethodsJsonInput" value="<%= JSON.stringify(settings.instantWithdrawMethods || []) %>">

    <!-- ===================== PENGATURAN UMUM ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-globe text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Pengaturan Umum</h2>
      </div>
      <div class="flex flex-col gap-3">
        <!-- Nama Gateway -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Nama Gateway</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="name" type="text" value="<%= settings.name %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Nama Gateway">
          </div>
        </div>
        <!-- WhatsApp Channel -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Channel Telegram</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="channelInformation" type="url" value="<%= settings.channelInformation %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>
        <!-- Contact Developer -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Contact Developer</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="contactDeveloper" type="url" value="<%= settings.contactDeveloper %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="https://...">
          </div>
        </div>        
        <!-- Judul Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Judul Landing Page</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="title" type="text" value="<%= settings.title %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Judul landing page">
          </div>
        </div>
        <!-- Deskripsi Landing Page -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Deskripsi Landing Page</label>
          <textarea name="description" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Deskripsi singkat..."><%= settings.description %></textarea>
        </div>
        <!-- ===== UPLOAD LOGO ===== -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Logo (Upload Gambar)</label>
          <div class="flex items-center gap-3">
            <label class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-4 py-3 text-xs font-medium text-gray-700 cursor-pointer hover:bg-gray-100 transition-all inline-flex items-center">
              <i class="fas fa-upload mr-2"></i> Pilih File
              <input type="file" name="logo" accept="image/*" id="logoInput" class="hidden">
            </label>
            <span id="logoFileName" class="text-xs text-gray-500">Tidak ada file dipilih</span>
          </div>
          <input type="hidden" name="existingLogoUrl" value="<%= settings.logoUrl || '' %>">
          <div id="logoPreview" class="mt-2 <%= settings.logoUrl ? '' : 'hidden' %>">
            <img src="<%= settings.logoUrl %>" class="h-12 w-auto object-cover" alt="Logo Preview">
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Format: PNG, JPG, GIF. Maks 2MB.</p>
        </div>
      </div>
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Pengaturan Umum
        </button>
      </div>
    </div>

    <!-- ===================== PAYMENT GATEWAY (PILIH PROVIDER) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-plug text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Payment Gateway</h2>
      </div>

      <!-- Pilihan Gateway -->
      <div class="mb-5">
        <label class="block text-xs font-medium text-gray-700 mb-3">Pilih Provider Integrasi</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200"
                 id="label-orderkuota">
            <input type="radio" name="paymentGateway" value="orderkuota" class="peer hidden"
                   <%= settings.paymentGateway === 'orderkuota' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://i.ibb.co.com/FqK256JH/IMG-20260603-WA0000.jpg" alt="Orderkuota" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Orderkuota</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-blue-500 peer-checked:bg-blue-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>

          <label class="relative flex flex-col items-center gap-3 p-4 rounded-xl border-2 cursor-pointer transition-all duration-200"
                 id="label-gopaymerchant">
            <input type="radio" name="paymentGateway" value="gopaymerchant" class="peer hidden"
                   <%= settings.paymentGateway === 'gopaymerchant' ? 'checked' : '' %>>
            <div class="w-12 h-12 rounded-xl overflow-hidden shrink-0">
              <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-xs font-semibold text-gray-800">Gopay Merchant</p>
            </div>
            <div class="absolute top-2 right-2 w-5 h-5 rounded-full border-2 border-gray-300 flex items-center justify-center peer-checked:border-green-500 peer-checked:bg-green-500 transition-all">
              <div class="w-2.5 h-2.5 rounded-full bg-white hidden peer-checked:block"></div>
            </div>
          </label>
        </div>
      </div>

      <!-- Konfigurasi Orderkuota -->
      <div id="config-orderkuota" class="<%= settings.paymentGateway !== 'orderkuota' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <img src="https://i.ibb.co.com/FqK256JH/IMG-20260603-WA0000.jpg" alt="Orderkuota" class="w-8 h-8 rounded-xl object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">Orderkuota</p>
            <p class="text-[10px] text-gray-400">Integrasi dengan API Orderkuota</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Domain Rest API</label>
            <input name="orderkuotaDomain" type="text" value="<%= settings.orderkuotaDomain || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="api.orderkuota.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Apikey Rest API</label>
            <input name="orderkuotaApiKey" type="text" value="<%= settings.orderkuotaApiKey || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="API Key">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Username Orderkuota</label>
            <input name="orderkuotaUsername" type="text" value="<%= settings.orderkuotaUsername || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Username">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Token Orderkuota</label>
            <input name="orderkuotaToken" type="text" value="<%= settings.orderkuotaToken || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Token">
          </div>
        </div>
      </div>

      <!-- Konfigurasi Gopay Merchant -->
      <div id="config-gopaymerchant" class="<%= settings.paymentGateway !== 'gopaymerchant' ? 'hidden' : '' %>">
        <div class="flex items-center gap-3 mb-3">
          <img src="https://i.ibb.co.com/VYL8rKdc/IMG-20260603-WA0001.jpg" alt="GoPay Merchant" class="w-8 h-8 rounded-xl object-cover border border-gray-200">
          <div>
            <p class="text-xs font-medium text-gray-800">Gopay Merchant</p>
            <p class="text-[10px] text-gray-400">Integrasi otomatis dengan API Gopay Merchant</p>
          </div>
        </div>
        <div class="flex flex-col gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Domain Rest API</label>
            <input name="gopayDomain" type="text" value="<%= settings.gopayDomain || 'gomerch.vercel.app' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="api.example.com">
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Token Gopay Merchant</label>
            <textarea name="gopayToken" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Token dari Gopay Merchant"><%= settings.gopayToken %></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Refresh Token Gopay Merchant</label>
            <textarea name="gopayRefreshToken" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="Refresh token dari Gopay Merchant"><%= settings.gopayRefreshToken || '' %></textarea>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">String QR Gopay Merchant</label>
            <!-- Upload Gambar QR -->
            <div class="mb-3">
              <label class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-4 py-2 text-xs font-medium text-gray-700 cursor-pointer hover:bg-gray-100 transition-all inline-flex items-center">
                <i class="fas fa-upload mr-2"></i> Upload Gambar QR
                <input type="file" id="qrImageInput" accept="image/*" class="hidden">
              </label>
              <span id="qrFileName" class="text-xs text-gray-400 ml-2">Tidak ada file</span>
            </div>
            <textarea name="gopayStaticQr" id="gopayStaticQr" rows="3" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 resize-none" placeholder="000201010211..."><%= settings.gopayStaticQr || '' %></textarea>
          </div>
        </div>
      </div>
      
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Gateway
        </button>
      </div>
    </div>

    <!-- ===================== ATURAN FINANSIAL (DENGAN RENTANG FEE) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-money-bill-wave text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Aturan Finansial</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Kolom Kiri: Minimal Deposit & Minimal Fee Random (Start) -->
        <div class="space-y-3">
          <!-- Minimal Deposit -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Deposit</label>
            <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minDeposit" type="number" value="<%= (typeof settings.minDeposit === 'number' && !isNaN(settings.minDeposit)) ? settings.minDeposit : 1000 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
            </div>
          </div>
          <!-- Minimal Fee Random (Start) -->
          <div>
            <label class="block text-xs font-medium text-gray-700 mb-2">Minimal Fee Random (Start)</label>
            <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
              <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
              <input name="minFee" type="number" value="<%= (typeof settings.minFee === 'number' && !isNaN(settings.minFee)) ? settings.minFee : 0 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full">
            </div>
            <p class="text-[10px] text-gray-400 mt-1">Nilai awal biaya acak, default 0.</p>
          </div>
        </div>

        <!-- Kolom Kanan: Maksimal Fee Random (Max) -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Maksimal Fee Random (Max)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <div class="pl-2 text-gray-400 text-xs font-medium">Rp</div>
            <input name="maxFee" type="number" value="<%= (typeof settings.maxFee === 'number' && !isNaN(settings.maxFee)) ? settings.maxFee : 500 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
          <p class="text-[10px] text-gray-400 mt-1">Batas atas biaya acak.</p>
        </div>
      </div>
      <!-- Tombol simpan -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Aturan Finansial
        </button>
      </div>
    </div>

    <!-- ===================== METODE WITHDRAW (MANUAL) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-200">
        <div class="flex items-center gap-2">
          <i class="fas fa-wallet text-gray-700 text-sm"></i>
          <h2 class="text-sm font-medium text-gray-800">Metode Withdraw Manual</h2>
        </div>
        <button type="button" id="btnAddMethod" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex items-center gap-2">
          <i class="fas fa-plus text-xs"></i>Metode
        </button>
      </div>
      <div id="withdrawMethodList" class="space-y-2 mb-3"></div>
    </div>
    
    <!-- ===================== ORDERKUOTA H2H — KREDENSIAL ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-link text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Orderkuota H2H — Kredensial</h2>
      </div>
      <div class="flex flex-col gap-3">
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">ID Merchant</label>
          <input name="h2hIdMerchant" type="text" value="<%= settings.h2hIdMerchant || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="ID Merchant H2H">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">PIN</label>
          <input name="h2hPin" type="text" value="<%= settings.h2hPin || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="PIN H2H">
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Password</label>
          <input name="h2hPassword" type="text" value="<%= settings.h2hPassword || '' %>" class="w-full bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 px-3 py-3 text-xs font-medium text-gray-800 outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500" placeholder="Password H2H">
        </div>
      </div>
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Kredensial H2H
        </button>
      </div>
    </div>    

    <!-- ===================== METODE WITHDRAW INSTAN (H2H) ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-200">
        <div class="flex items-center gap-2">
          <i class="fas fa-bolt text-gray-700 text-sm"></i>
          <h2 class="text-sm font-medium text-gray-800">Metode Withdraw Instan (H2H)</h2>
        </div>
        <button type="button" id="btnAddInstantMethod" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex items-center gap-2">
          <i class="fas fa-plus text-xs"></i>Metode Instan
        </button>
      </div>
      <div id="instantMethodList" class="space-y-2 mb-3"></div>
    </div>

    <!-- ===================== SISTEM OTOMATISASI ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-cogs text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Sistem Otomatisasi</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Interval Cek Mutasi -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Interval Cek Mutasi (Detik)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="checkInterval" type="number" value="<%= (typeof settings.checkInterval === 'number' && !isNaN(settings.checkInterval)) ? settings.checkInterval : 20 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
        </div>
        <!-- Kedaluwarsa QRIS -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Kedaluwarsa QRIS (Menit)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="qrisExpiredMinutes" type="number" value="<%= (typeof settings.qrisExpiredMinutes === 'number' && !isNaN(settings.qrisExpiredMinutes)) ? settings.qrisExpiredMinutes : 30 %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" required>
          </div>
        </div>
      </div>
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Otomatisasi
        </button>
      </div>
    </div>

    <!-- ===================== TELEGRAM BOT ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fab fa-telegram-plane text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Telegram Bot</h2>
      </div>

      <!-- Status Bot -->
      <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3 mb-3 border border-gray-200">
        <div class="flex items-center gap-1">
          <div class="w-3 h-3 rounded-full <%= botStatus === 'Running' ? 'bg-green-500' : 'bg-red-500' %>"></div>
          <span class="text-xs font-medium <%= botStatus === 'Running' ? 'text-green-600' : 'text-red-600' %>" id="botStatusText">
            <%= botStatus %>
          </span>
        </div>
        <div class="flex items-center gap-1">
          <!-- Tombol Restart (hanya jika bot berjalan) -->
          <% if (botStatus === 'Running') { %>
          <button type="button" id="restartBotBtn"
                  class="w-8 h-8 flex items-center justify-center rounded-xl text-xs text-white bg-yellow-500 hover:bg-yellow-600 shadow-sm transition-all"
                  onclick="restartBot()" title="Restart Bot">
            <i class="fas fa-sync-alt text-xs"></i>
          </button>
          <% } %>
          <!-- Tombol Toggle (ikon saja) -->
          <button type="button" id="toggleBotBtn"
                  class="w-8 h-8 flex items-center justify-center rounded-xl text-xs text-white shadow-sm transition-all
                  <%= botStatus === 'Running' ? 'bg-red-500 hover:bg-red-600' : 'bg-green-500 hover:bg-green-600' %>"
                  onclick="toggleBot()" title="<%= botStatus === 'Running' ? 'Stop Bot' : 'Start Bot' %>">
            <i class="fas <%= botStatus === 'Running' ? 'fa-power-off' : 'fa-play' %> text-xs"></i>
          </button>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <!-- Token Bot -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Token Bot</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="telegramBotToken" type="text" value="<%= settings.telegramBotToken %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Masukkan token dari @BotFather">
          </div>
        </div>
        <!-- Owner ID -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Owner ID (ID Telegram Anda)</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="telegramOwnerId" type="text" value="<%= settings.telegramOwnerId %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="Contoh: 123456789">
          </div>
        </div>
        <!-- Enabled (hidden) -->
        <input type="hidden" name="telegramBotEnabled" id="telegramBotEnabledInput" value="<%= settings.telegramBotEnabled ? 'on' : '' %>">
      </div>

      <!-- Tombol simpan -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan Pengaturan Bot
        </button>
      </div>
    </div>

    <!-- ===================== KONFIGURASI SMTP EMAIL ===================== -->
    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-5 mb-4">
      <div class="flex items-center gap-2 mb-4 pb-3 border-b border-gray-200">
        <i class="fas fa-envelope text-gray-700 text-sm"></i>
        <h2 class="text-sm font-medium text-gray-800">Konfigurasi SMTP Email</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <!-- Email Gmail -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">Email Gmail</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="smtpUser" type="email" value="<%= settings.smtpUser %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="emailanda@gmail.com">
          </div>
        </div>
        <!-- App Password -->
        <div>
          <label class="block text-xs font-medium text-gray-700 mb-2">App Password</label>
          <div class="flex items-center bg-white border border-gray-100 rounded-2xl shadow-sm shadow-gray-200/50 hover:shadow-md transition-shadow duration-300 p-1.5 transition-all focus-within:border-gray-500 focus-within:ring-1 focus-within:ring-gray-500">
            <input name="smtpPass" type="text" value="<%= settings.smtpPass %>" class="flex-1 bg-transparent px-2 py-2 text-xs font-medium text-gray-800 outline-none w-full" placeholder="16 karakter App Password">
          </div>
          <p class="text-[10px] text-gray-400 mt-1.5">Gunakan App Password dari Google, bukan password login biasa.</p>
        </div>
      </div>
      <!-- Tombol simpan khusus card ini -->
      <div class="flex justify-end mt-5 pt-4 border-t border-gray-100">
        <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white w-full px-3 py-4 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2">
          <i class="fas fa-save text-xs"></i> Simpan SMTP
        </button>
      </div>
    </div>

  </form>

  <!-- ===================== ZONA BERBAHAYA — RESET DATABASE ===================== -->
  <div class="bg-white border border-red-200 rounded-xl p-5 mb-8">
    <div class="flex items-center gap-2 mb-4 pb-3 border-b border-red-100">
      <i class="fas fa-exclamation-triangle text-gray-700 text-sm"></i>
      <div>
        <h2 class="text-sm font-medium text-gray-800">Zona Berbahaya</h2>
        <p class="text-xs font-medium text-gray-500 mt-0.5">Pengaturan di bawah ini akan berdampak fatal pada data Anda.</p>
      </div>
    </div>
    
    <div class="flex flex-col md:flex-row md:items-center justify-between bg-red-50/50 rounded-xl p-4 border border-red-100 gap-3">
      <div>
        <h3 class="text-xs font-medium text-red-600">Reset Database</h3>
        <p class="text-[11px] text-red-500 mt-1 max-w-xl">Menghapus permanen semua data pengguna, invoice, transaksi, dan withdrawal. Data admin & pengaturan tidak akan terhapus.</p>
      </div>
      <form action="/admin/settings/reset" method="POST" 
            onsubmit="var answer = prompt('Ketik RESET untuk melanjutkan reset database:'); 
                      if (answer !== 'RESET') { 
                        alert('Reset dibatalkan. Anda harus mengetik RESET dengan benar.'); 
                        return false; 
                      } 
                      return confirm('⚠️ PERINGATAN TERAKHIR!\n\nApakah Anda yakin ingin mereset database?\nSemua data pengguna, invoice, transaksi, dan withdrawal akan DIHAPUS PERMANEN.\nData admin & pengaturan TIDAK akan terhapus.\n\nKlik OK untuk melanjutkan atau Batal.');">
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white w-full md:w-auto px-5 py-3 rounded-xl text-xs font-medium shadow-sm transition-all inline-flex justify-center items-center gap-2 whitespace-nowrap">
          <i class="fas fa-trash-alt text-xs"></i> Reset Database
        </button>
      </form>
    </div>
  </div>
</div>

