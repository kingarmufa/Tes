<script>
  const baseUrl = window.location.origin;

  // Update URL endpoints
  document.getElementById('urlBalance').textContent = baseUrl + '/api/balance';
  document.getElementById('urlInvoice').textContent = baseUrl + '/api/invoice';
  document.getElementById('urlStatus').textContent = baseUrl + '/api/invoice/status';
  document.getElementById('urlWithdrawMethods').textContent = baseUrl + '/api/withdraw/methods';
  document.getElementById('urlWithdraw').textContent = baseUrl + '/api/withdraw';
  document.getElementById('urlWithdrawStatus').textContent = baseUrl + '/api/withdraw/status';

  // Replace all BASE_URL placeholders in code blocks
  document.querySelectorAll('.base-url-placeholder').forEach(el => {
    el.textContent = baseUrl;
  });

  function switchCodeTab(btn, lang) {
    const switcher = btn.closest('[data-code-switcher]');
    if (!switcher) return;

    switcher.querySelectorAll('.code-tab').forEach(tab => {
      tab.classList.remove('active', 'bg-white', 'border', 'border-b-0', 'border-gray-300', 'text-gray-800', '-mb-px', 'relative', 'z-10');
      tab.classList.add('text-gray-500', 'border-transparent');
    });

    btn.classList.add('active', 'bg-white', 'border', 'border-b-0', 'border-gray-300', 'text-gray-800', '-mb-px', 'relative', 'z-10');
    btn.classList.remove('text-gray-500', 'border-transparent');

    switcher.querySelectorAll('.copy-content[data-code]').forEach(code => {
      if (code.getAttribute('data-code') === lang) {
        code.classList.remove('hidden');
      } else {
        code.classList.add('hidden');
      }
    });
  }

  function copyCode(btn) {
    const container = btn.closest('[data-code-switcher]') || btn.closest('.relative');
    let codeElement = null;

    if (container && container.hasAttribute('data-code-switcher')) {
      codeElement = container.querySelector('.copy-content:not(.hidden)');
    } else {
      codeElement = container ? container.querySelector('.copy-content') : null;
    }

    const text = codeElement ? (codeElement.innerText || codeElement.textContent) : '';
    if (!text) return;

    navigator.clipboard.writeText(text).then(() => {
      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fas fa-check text-sm text-green-500';
        setTimeout(() => { icon.className = 'far fa-copy text-sm'; }, 1500);
      }
    }).catch(() => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);

      const icon = btn.querySelector('i');
      if (icon) {
        icon.className = 'fas fa-check text-sm text-green-500';
        setTimeout(() => { icon.className = 'far fa-copy text-sm'; }, 1500);
      }
    });
  }
</script>

